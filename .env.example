# ==========================================================
# SKYROVIX LMS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.production and provide real credentials
# ==========================================================

# Dedicated Node Server Port (Contabo VPS isolated port)
PORT=3005
NODE_ENV=production
VITE_APP_URL="https://skyrovix.in"

# Dedicated MySQL 8.0 Connection
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_DATABASE="skyrovix_main_db"
MYSQL_USER="skyrovix_main_user"
MYSQL_PASSWORD="YOUR_STRONG_DATABASE_PASSWORD"

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET="YOUR_RANDOM_SECURE_JWT_SECRET_KEY_HERE"

# Transactional Email (SMTP / Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="skyrovix@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD_HERE"
SMTP_FROM="Skyrovix <skyrovix@gmail.com>"
GMAIL_USER="skyrovix@gmail.com"
GMAIL_APP_PASSWORD="YOUR_GMAIL_APP_PASSWORD_HERE"

# Cashfree Payment Gateway (Server-Side Only)
# Use "SANDBOX" for testing, "PRODUCTION" for live transactions
CASHFREE_ENVIRONMENT="PRODUCTION"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_PROD_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_PROD_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
